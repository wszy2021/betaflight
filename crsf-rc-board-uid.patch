+float crsfChannelToPwm(uint32_t raw, float scale)
+{
+    if (scale == CRSF_RC_CHANNEL_SCALE_LEGACY) {
+        return (scale * (float)raw) + 881;
+    }
+
+    return (scale * (float)raw) + 988;
+}
